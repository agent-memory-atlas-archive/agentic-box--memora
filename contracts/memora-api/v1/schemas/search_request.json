{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memora-api/v1/search_request.json",
  "title": "POST /api/v1/{store}/search request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query"
  ],
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "top_k": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "default": 5
    },
    "tags_any": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "preview_chars": {
      "type": "integer",
      "minimum": 0,
      "maximum": 400,
      "default": 200
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,64}$",
      "description": "Only memories explicitly in this project (metadata.project, or a tag equal to it or prefixed '<project>/'). Must be one of the store's declared projects when it declares any."
    }
  }
}
